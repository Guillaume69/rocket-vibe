# The native verification script runs in Linux containers even from Windows checkouts.
apps/server/scripts/*.sh text eol=lf
apps/desktop/scripts/*.sh text eol=lf
crates/rv-crypto-public/fixtures/*.json text eol=lf
docs/protocol/*.json text eol=lf
docs/protocol/*.md text eol=lf
crates/rv-protocol/data/emoji-aliases.json text eol=lf
apps/mobile/providers/rocketvibe/*.generated.ts text eol=lf
apps/desktop/macos/scripts/*.sh text eol=lf
apps/web/** text eol=lf
apps/web/**/*.ttf -text
apps/web/**/*.png -text
apps/web/**/*.ogg -text
apps/web/**/*.wasm -text
# Preserve upstream licence whitespace and generated bundle notices.
apps/web/src/fonts-native/* -whitespace
apps/web/src/icons-native/COPYING* -whitespace
apps/web/src/crypto/wasm/LICENSES.txt -whitespace
apps/web/dist/** -whitespace
