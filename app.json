{
  "expo": {
    "name": "rocket-vibe",
    "slug": "rocket-vibe",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "rocketvibe",
    "android": {
      "package": "com.rocketvibe.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0B16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "./plugins/with-canal-notifications",
      "expo-audio",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/baloo-2/600SemiBold/Baloo2_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/baloo-2/700Bold/Baloo2_700Bold.ttf",
            "node_modules/@expo-google-fonts/baloo-2/800ExtraBold/Baloo2_800ExtraBold.ttf",
            "node_modules/@expo-google-fonts/nunito/400Regular/Nunito_400Regular.ttf",
            "node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
            "node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser rocket-vibe à accéder à vos photos pour les partager dans une conversation.",
          "cameraPermission": "Autoriser rocket-vibe à utiliser la caméra pour prendre une photo ou une vidéo à partager.",
          "microphonePermission": "Autoriser rocket-vibe à utiliser le micro pour le son des vidéos."
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["text/*", "*/*"],
          "androidMultiIntentFilters": ["*/*"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
