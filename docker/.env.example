# Copy to `.env` (gitignored) and adjust.
#
#   cp .env.example .env
#
# ROOT_URL must carry the host machine's LAN IP, never localhost or
# 10.0.2.2: a physical phone must reach this server. `source
# scripts/env.sh` computes the IP and exposes it as $RV_LAN_IP.
ROOT_URL=http://192.168.1.106:3000
PORT=3000

# Pinned to the version of the target production server (chat.barrut.me), not
# to the latest release. 8.5 is LTS until 2027-06-30.
RC_VERSION=8.5.1
# Linux kernel >= 6.19: use 8.0.4-ubi8, 8.0.5+ refuse to start
# (SERVER-121912, tcmalloc/rseq), no override. See compose.yml.
MONGODB_VERSION=8.0-ubi8

# Administrator created on first startup.
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@rocket-vibe.test
ADMIN_PASS=replace-me
