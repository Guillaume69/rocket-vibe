# Copier en `.env` (gitignoré) et adapter.
#
#   cp .env.example .env
#
# ROOT_URL doit porter l'IP LAN de la machine hôte, jamais localhost ni
# 10.0.2.2 : un téléphone physique doit joindre ce serveur. `source
# scripts/env.sh` calcule l'IP et l'expose dans $RV_LAN_IP.
ROOT_URL=http://192.168.1.106:3000
PORT=3000

# Épinglé sur la version du serveur de production visé (chat.barrut.me), pas
# sur la dernière publiée. 8.5 est LTS jusqu'au 2027-06-30.
RC_VERSION=8.5.1
# Noyau Linux >= 6.19 : mettre 8.0.4-ubi8 — les 8.0.5+ refusent de démarrer
# (SERVER-121912, tcmalloc/rseq), sans dérogation. Voir compose.yml.
MONGODB_VERSION=8.0-ubi8

# Administrateur créé au premier démarrage.
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@rocket-vibe.test
ADMIN_PASS=remplace-moi
