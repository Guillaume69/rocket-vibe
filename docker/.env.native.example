# Use a fresh strong password. URL-escape special characters in DATABASE_URL if needed.
RV_DATABASE_PASSWORD=
# Voice (docker/compose.voice.yml): the host's LAN address, reachable from
# phones and emulators, and a LiveKit key with a random secret of 32+ bytes.
RV_LIVEKIT_NODE_IP=
RV_LIVEKIT_API_KEY=rocketvibe
RV_LIVEKIT_API_SECRET=
