{
  "name": "rocket-vibe-packages",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "rocket-vibe-packages",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@rocket-vibe/provider-api": {
      "resolved": "packages/provider-api",
      "link": true
    },
    "node_modules/@rocket-vibe/provider-slack": {
      "resolved": "packages/provider-slack",
      "link": true
    },
    "node_modules/@rocket-vibe/provider-teams": {
      "resolved": "packages/provider-teams",
      "link": true
    },
    "packages/provider-api": {
      "name": "@rocket-vibe/provider-api",
      "version": "0.0.0"
    },
    "packages/provider-slack": {
      "name": "@rocket-vibe/provider-slack",
      "version": "0.0.0",
      "dependencies": {
        "@rocket-vibe/provider-api": "0.0.0"
      }
    },
    "packages/provider-teams": {
      "name": "@rocket-vibe/provider-teams",
      "version": "0.0.0",
      "dependencies": {
        "@rocket-vibe/provider-api": "0.0.0"
      }
    }
  }
}
